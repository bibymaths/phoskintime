[run]
omit =
    .pixi/*
    */site-packages/*

[report]
fail_under = 60
include =
    protwise/paramest/normest.py
    protwise/models/diffrax_solver.py
    protwise/models/distmod.py
    protwise/models/protwise.py
    protwise/models/randmod.py
    protwise/models/succmod.py
    networkmodel/BayesianInference.py
    networkmodel/OptimizationProblem.py
    networkmodel/backend.py
    networkmodel/cache.py
    networkmodel/config.py
    networkmodel/dashboard_bundle.py
    networkmodel/mode_outputs.py
