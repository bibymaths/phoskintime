__pycache__/
out/
# Ignore .pyc files
*.py[cod]

 
/*.csv 
/*.xlsx 
.venv/

# Ignore all bash scripts in the project root
/*.sh

# But keep the root __init__.py and __main__.py so the package remains valid
!/__init__.py
!/__main__.py

# Ignore runtime logs
logs/

# Ignore all result directories
/*results*/

# Ignore any raw data directory
/data/

# Ignore raw processing inputs and any CSV outputs under processing
/processing/raw/
/processing/*.csv

# Ignore Python bytecode caches
__pycache__/

# Ignore network definitions or outputs
/network/

# Ignore mapping files
/mapping/

# Ignore any lock files
#*.lock

# Ignore any environment files
*.env

# Ignore any dist files - wheels
/dist/
.idea/

site/
# Ignore generated educational notebook outputs while preserving directory structure
/notebooks/outputs/**
!/notebooks/outputs/
!/notebooks/outputs/*/
!/notebooks/outputs/*/.gitkeep

# Dashboard uploads and local archives
/dashboard_uploads/
*.zip
/results/
/.streamlit/
.vscode/settings.json
coverage.xml

# Coverage data file (generated by pytest-cov)
.coverage

# Runtime log files (loggers write dated *.log files into the working directory)
*.log

# Default output folders of analysis/figure scripts
/dynestyx_ode_smoothing/
/poster_figures/

# Persistent JAX compilation cache (common/jax_cache.py; PHOSKINTIME_JAX_CACHE_DIR)
/.jax_cache/
